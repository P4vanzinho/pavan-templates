---
import type { SiteSettings } from "../../types/content";
import "./lume.css";

interface Props {
	settings: SiteSettings;
	pageTitle?: string;
}

const { settings, pageTitle } = Astro.props;
const title = pageTitle ? `${pageTitle} — ${settings.title}` : settings.title;
const themeStyle = `--paper:${settings.theme.paper};--ink:${settings.theme.ink};--accent:${settings.theme.accent}`;
---

<!doctype html>
<html lang="pt-BR" style={themeStyle}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="theme-color" content={settings.theme.paper} />
		<meta name="description" content={settings.description} />
		<title>{title}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preload" href="/templates/lume/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<header class="header container">
			<a class="brand" href="/" aria-label={`${settings.title}, início`}>
				<span class="brand-mark" aria-hidden="true"></span>
				<span class="brand-word">{settings.title}</span>
			</a>
		</header>
		<main id="main">
			<slot />
		</main>
	</body>
</html>
